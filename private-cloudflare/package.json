{
  "name": "segundo-cerebro-private",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test src/*.test.mjs ../app/*.test.mjs",
    "dev": "npm run build && wrangler dev --config wrangler.bootstrap.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.bootstrap.jsonc",
    "deploy:health-ingest": "wrangler deploy --config wrangler.health-ingest.jsonc",
    "deploy:shopping-reminders": "wrangler deploy --config wrangler.shopping-reminders.jsonc",
    "setup:health-ingest": "node scripts/setup-health-ingest.mjs",
    "health:backfill": "python3 scripts/import-apple-health-history.py",
    "family:import": "node scripts/import-family-cases-private.mjs",
    "pantry:configure": "node scripts/configure-pantry-sync.mjs",
    "reminders:sync": "../macos/SegundoCerebroReminders/scripts/sync.sh",
    "reminders:status": "../macos/SegundoCerebroReminders/scripts/status.sh",
    "reminders:install": "../macos/SegundoCerebroReminders/scripts/install.sh",
    "reminders:configure": "node scripts/configure-shopping-reminders.mjs",
    "google:reauthorize-calendar": "node scripts/reauthorize-google-calendar.mjs"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0"
  }
}
