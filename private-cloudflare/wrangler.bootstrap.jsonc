{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "segundo-cerebro",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "segundo-cerebro-private",
      "database_id": "0916849e-dc98-4e3e-832d-390062fa738d"
    }
  ],
  "vars": {
    "PRIVATE_APP_ENABLED": "true",
    "OBJECTS_BRIDGE_UPSTREAM_SHA256": "07046971ae838a35b5839f788438ef5adf6c66b624036a5f9552eb7141213b4c"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
