{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "segundo-cerebro-private",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PRIVATE_APP_ENABLED": "false"
  }
}
